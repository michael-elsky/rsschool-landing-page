section.app#mobile-app
  .container 
    .app__wrapper 
      .app__download 
        h2.app__download-heading
          span Download 
          | our app to start ordering

        p.app__download-text Download the Resource app today and experience the comfort of ordering your favorite coffee from wherever you are

        .app__download-btns 
          a.app__download-btn(href="https://www.apple.com/app-store/", target="_blank",title="download from app store")
            +appleIcon()
            div
              span Available on the 
              span App Store
          a.app__download-btn(href="https://play.google.com/store/", target="_blank", title="download from google play")
            +googlePlayIcon()
            div
              span Available on 
              span Google Play

      .app__download-img 
        img(src="mobile-app/mobile-screens.png", alt="mobile screens")