- 
  var tabs = [
    { type: "button", text: "Coffee", imagePath: "icons/tabs/coffee.png" },
    { type: "button", text: "Tea", imagePath: "icons/tabs/tea.png" },
    { type: "button", text: "Dessert", imagePath: "icons/tabs/dessert.png" },
  ]

main.catalog 
  .container 
    section.catalog__wrapper 
      h1.catalog__heading Behind each of our cups hides an 
        span amazing surprise
      
      ul.catalog__tabs-list
        each tab, index in tabs 
          if index === 0
            li.catalog__tabs-item
              button.catalog__tab.catalog__tab--active(type=tab.type)
                span
                  img(src=tab.imagePath, alt=tab.text)
                = tab.text
          else 
            li.catalog__tabs-item
              button.catalog__tab(type=tab.type)
                span
                  img(src=tab.imagePath, alt=tab.text)
                = tab.text

      
      .catalog__products

    button.catalog__show-more(type="button", aria-label="show more products") Show more
      svg(width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
